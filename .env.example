# Database
DB_URI=mongodb://your_username:your_password@localhost:27017/skedge?authSource=admin

# JWT Keys (RS256)
# Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then paste contents here, using the same formatting
# or on one line, replacing newlines with \n
PRIVATE_RSA_KEY="-----BEGIN RSA PRIVATE KEY-----
...{replace this line with your private key}...
-----END RSA PRIVATE KEY-----"
PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...{replace this line with your public key}...
-----END PUBLIC KEY-----"

# MongoDB Docker credentials (used by docker-compose)
MONGO_INITDB_ROOT_USERNAME=your_username
MONGO_INITDB_ROOT_PASSWORD=your_password
ME_CONFIG_MONGODB_ADMINUSERNAME=your_username
ME_CONFIG_MONGODB_ADMINPASSWORD=your_password
ME_CONFIG_MONGODB_URL=mongodb://your_username:your_password@mongo:27017/